# Copia este archivo como .env y ajusta los valores (el .env real NO se sube a GitHub).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/perfil_medico
SECRET_KEY=pega-aqui-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Tareas programadas, recordatorios y alertas (Sprint 4) ---
# Activa la tarea que genera actividades y envía recordatorios y alertas. Con Docker
# Compose ya viene en "true" (lo fija docker-compose.yml); sin Docker hay que ponerla
# en true para que se generen actividades y avisos solos.
TAREAS_PROGRAMADAS=false
# Cada cuántos segundos corre la tarea.
TAREAS_INTERVALO_SEGUNDOS=60
# Zona horaria en la que se interpretan las horas de las actividades.
ZONA_HORARIA=America/Santiago
# Días hacia adelante (además de hoy) para los que se generan actividades.
GENERAR_DIAS_ADELANTE=2
# Minutos antes de la hora en que se envía el recordatorio (HU 9).
RECORDATORIO_MINUTOS_ANTES=10
# Minutos después de la hora, sin confirmar, para la alerta de nivel 1 y de nivel 2 (HU 10).
# Para probar rápido se pueden bajar (por ejemplo 1 y 5); por defecto son 30 y 60.
ALERTA_PLAZO_1_MINUTOS=30
ALERTA_PLAZO_2_MINUTOS=60
# Cómo se entregan los avisos al dispositivo: "log" solo los registra en el log del
# backend (el push real con FCM aún no está implementado).
NOTIFICADOR=log
