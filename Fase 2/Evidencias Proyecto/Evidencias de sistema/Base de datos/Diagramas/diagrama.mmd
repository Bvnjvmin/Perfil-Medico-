erDiagram
    USUARIO {
        string id PK "UUID"
        string nombre
        string email UK
        string hashed_password
        datetime creado_en
    }

    PERFIL {
        uuid id PK
        string cuenta_titular_id FK "usuario dueño del perfil"
        string tipo "titular | dependiente"
        string nombre
        string rut "nullable"
        string grupo_sanguineo
        date fecha_nacimiento
        string subtipo "adulto_mayor | nino - solo dependientes"
        bool activo
        datetime creado_en
    }

    ALERGIA {
        uuid id PK
        uuid perfil_id FK "ON DELETE CASCADE"
        string sustancia
        string severidad "leve | moderada | severa"
    }

    CONTACTO_EMERGENCIA {
        uuid id PK
        uuid perfil_id FK "ON DELETE CASCADE"
        string nombre
        string telefono
        string relacion
        int prioridad
    }

    MEDICAMENTO {
        uuid id PK "Sprint 2"
        uuid perfil_id FK "ON DELETE CASCADE"
        string nombre
        string dosis
        string frecuencia
        time hora_inicio "nullable"
        bool activo
        datetime creado_en
    }

    RUTINA_CUIDADO {
        uuid id PK "Sprint 2"
        uuid perfil_id FK "ON DELETE CASCADE"
        string tipo "alimentacion | hidratacion | vitaminas"
        string descripcion "nullable"
        string frecuencia
        time hora "nullable"
        bool activo
        datetime creado_en
    }

    ACTIVIDAD {
        uuid id PK "Sprint 3"
        uuid perfil_id FK "ON DELETE CASCADE"
        uuid medicamento_id FK "nullable - ON DELETE CASCADE"
        uuid rutina_id FK "nullable - ON DELETE CASCADE"
        date fecha
        time hora "nullable - Sprint 4"
        string estado "pendiente | confirmada | vencida | omitida"
        datetime confirmada_en "nullable"
        string confirmada_por_id FK "nullable - ON DELETE SET NULL"
    }

    PERFIL_ACCESO {
        uuid id PK "Sprint 3"
        string usuario_id FK "ON DELETE CASCADE"
        uuid perfil_id FK "ON DELETE CASCADE"
        string rol_vinculo "cuidador | lectura"
        bool puede_confirmar
        bool puede_editar_rutinas
        bool puede_ver_indicadores
        bool recibe_alertas
        int nivel_escalamiento
    }

    RUTINA_HORARIO {
        uuid id PK "Sprint 4"
        uuid medicamento_id FK "nullable - ON DELETE CASCADE"
        uuid rutina_id FK "nullable - ON DELETE CASCADE"
        time hora
    }

    ALERTA {
        uuid id PK "Sprint 4"
        uuid actividad_id FK "ON DELETE CASCADE"
        string usuario_id FK "destinatario - ON DELETE CASCADE"
        string tipo "recordatorio | alerta"
        int nivel "0 recordatorio, 1 y 2 alertas"
        string mensaje
        datetime creada_en
        datetime leida_en "nullable"
    }

    DISPOSITIVO_PUSH {
        uuid id PK "Sprint 4"
        string usuario_id FK "ON DELETE CASCADE"
        string token UK
        string plataforma
        datetime creado_en
    }

    INDICADOR_SALUD {
        uuid id PK "Sprint 5"
        uuid perfil_id FK "ON DELETE CASCADE"
        string tipo "peso | presion | glucosa | frecuencia_cardiaca"
        decimal valor "sistolica en presion"
        decimal valor_secundario "diastolica - solo presion"
        string unidad "kg | mmHg | mg/dL | lpm"
        string fuente "manual | pulsera"
        datetime medido_en
        string nota "nullable"
        string registrado_por_id FK "nullable - ON DELETE SET NULL"
        datetime creado_en
    }

    PULSERA {
        uuid id PK "Sprint 5"
        uuid perfil_id FK "ON DELETE CASCADE"
        string identificador UK "uniqueId en Traccar"
        string nombre
        string modelo "nullable"
        bool activa
        int bateria_pct "nullable"
        datetime ultima_conexion "nullable"
        datetime creado_en
    }

    POSICION {
        uuid id PK "Sprint 5"
        uuid pulsera_id FK "ON DELETE CASCADE"
        float latitud
        float longitud
        float precision_m "nullable"
        float velocidad_kmh "nullable"
        int bateria_pct "nullable"
        datetime registrada_en
    }

    GEOCERCA {
        uuid id PK "Sprint 5"
        uuid perfil_id FK "ON DELETE CASCADE"
        string nombre "unico por perfil"
        float latitud
        float longitud
        int radio_m "20 a 50000"
        bool activa
        datetime creado_en
    }

    EVENTO_SEGURIDAD {
        uuid id PK "Sprint 5"
        uuid perfil_id FK "ON DELETE CASCADE"
        uuid pulsera_id FK "nullable - ON DELETE SET NULL"
        string tipo "asistencia | sos | caida | bateria_baja | inactividad | geocerca_salida"
        string origen "app | pulsera | sistema"
        string mensaje
        datetime creado_en
        datetime atendido_en "nullable"
        string atendido_por_id FK "nullable - ON DELETE SET NULL"
        string creado_por_id FK "nullable - ON DELETE SET NULL"
    }

    CONSULTA_IA {
        uuid id PK "Sprint 5"
        uuid perfil_id FK "ON DELETE CASCADE"
        string usuario_id FK "ON DELETE CASCADE"
        string pregunta
        string respuesta
        string proveedor "simulado | anthropic | reglas"
        string modelo "nullable"
        string contexto_resumen "que datos se enviaron"
        datetime creada_en
    }

    USUARIO ||--o{ PERFIL : "administra (titular y dependientes)"
    USUARIO ||--o{ PERFIL_ACCESO : "tiene acceso a"
    PERFIL ||--o{ PERFIL_ACCESO : "tiene cuidadores autorizados"
    PERFIL ||--o{ ALERGIA : "registra"
    PERFIL ||--o{ CONTACTO_EMERGENCIA : "registra"
    PERFIL ||--o{ MEDICAMENTO : "tiene medicamentos"
    PERFIL ||--o{ RUTINA_CUIDADO : "tiene rutinas"
    PERFIL ||--o{ ACTIVIDAD : "tiene actividades"
    MEDICAMENTO ||--o{ ACTIVIDAD : "genera (una por horario y dia)"
    RUTINA_CUIDADO ||--o{ ACTIVIDAD : "genera (una por horario y dia)"
    USUARIO ||--o{ ACTIVIDAD : "confirma (directo o proxy)"
    MEDICAMENTO ||--o{ RUTINA_HORARIO : "se toma a las"
    RUTINA_CUIDADO ||--o{ RUTINA_HORARIO : "se hace a las"
    ACTIVIDAD ||--o{ ALERTA : "origina avisos"
    USUARIO ||--o{ ALERTA : "recibe"
    USUARIO ||--o{ DISPOSITIVO_PUSH : "registra"
    PERFIL ||--o{ INDICADOR_SALUD : "registra mediciones"
    USUARIO ||--o{ INDICADOR_SALUD : "registra (puede quedar nulo)"
    PERFIL ||--o{ PULSERA : "usa"
    PULSERA ||--o{ POSICION : "reporta"
    PERFIL ||--o{ GEOCERCA : "define zonas"
    PERFIL ||--o{ EVENTO_SEGURIDAD : "genera"
    PULSERA ||--o{ EVENTO_SEGURIDAD : "detecta (puede quedar nulo)"
    PERFIL ||--o{ CONSULTA_IA : "es consultado"
    USUARIO ||--o{ CONSULTA_IA : "pregunta"
